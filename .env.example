# GEMINI_API_KEY: Required for Gemini AI API calls (Chat, TTS, Live, Grounding).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: ElevenLabs key for premium voice (Browser TTS and Gemini 3.8 TTS work by default)
# ELEVENLABS_API_KEY=

# GitHub Actions integration (server-side only; never put this token in frontend/localStorage).
# Use a fine-grained token restricted to the allowlisted repository with Actions read/write.
GITHUB_ACTIONS_TOKEN=""
# Comma-separated exact owner/repo allowlist.
GITHUB_ALLOWED_REPOSITORIES=""
# Comma-separated exact owner/repo:workflow.yml allowlist (for example: example-org/sara-automation:release.yml).
GITHUB_ALLOWED_WORKFLOWS=""
