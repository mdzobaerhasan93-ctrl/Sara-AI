# GEMINI_API_KEY: Required for Gemini AI API calls (Chat, TTS, Live, Grounding).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: ElevenLabs key for premium voice (Browser TTS and Gemini 3.8 TTS work by default)
# ELEVENLABS_API_KEY=

# GitHub OAuth for real user sign-in (not the workflow-dispatch token).
# Register this exact callback URL in your GitHub OAuth App.
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""
GITHUB_OAUTH_CALLBACK_URL="https://your-app.example.com/api/auth/github/callback"
# Keep this 32+ character random secret on the server only.
SARA_SESSION_SECRET=""
# Only these GitHub usernames can sign in and approve workflows; comma-separated.
SARA_GITHUB_ALLOWED_USERS=""
